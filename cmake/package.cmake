# Archive a freshly installed Runtime tree, with a second explicit file check.
foreach(required IN ITEMS PACKAGE_ROOT OUTPUT_DIR PLATFORM)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing package argument: ${required}")
  endif()
endforeach()
if(NOT PLATFORM MATCHES "^(linux-x86_64|windows-x86_64|macos-arm64)$")
  message(FATAL_ERROR "Unsupported package platform: ${PLATFORM}")
endif()
cmake_minimum_required(VERSION 3.30)
if(IS_SYMLINK "${PACKAGE_ROOT}/apache")
  message(FATAL_ERROR "Runtime package root must not be a symbolic link")
endif()
file(GLOB_RECURSE files LIST_DIRECTORIES true RELATIVE "${PACKAGE_ROOT}/apache" "${PACKAGE_ROOT}/apache/*")
foreach(file IN LISTS files)
  if(IS_SYMLINK "${PACKAGE_ROOT}/apache/${file}")
    message(FATAL_ERROR "Symbolic link in runtime package: ${file}")
  endif()
  if(IS_DIRECTORY "${PACKAGE_ROOT}/apache/${file}")
    if(NOT file MATCHES "^(scripts|docs|licenses|licenses/glfw|licenses/miniaudio)$")
      message(FATAL_ERROR "Unexpected runtime package directory: ${file}")
    endif()
    continue()
  endif()
  if(NOT file MATCHES "^(apache([.]exe)?|README[.]md|NOTICE[.]md|scripts/fetch-assets[.](sh|bat)|docs/(build-release|implementation)[.]md|licenses/(glfw/LICENSE[.]md|miniaudio/LICENSE))$"
      OR IS_SYMLINK "${PACKAGE_ROOT}/apache/${file}")
    message(FATAL_ERROR "Unexpected runtime package file: ${file}")
  endif()
endforeach()
if(NOT EXISTS "${PACKAGE_ROOT}/apache/apache" AND NOT EXISTS "${PACKAGE_ROOT}/apache/apache.exe")
  message(FATAL_ERROR "No installed Apache executable")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
string(REGEX REPLACE "-.*$" "" platform_name "${PLATFORM}")
set(name "apache-${platform_name}")
if(PLATFORM MATCHES "^windows-")
  set(arguments cf "${OUTPUT_DIR}/${name}.zip" --format=zip apache)
else()
  set(arguments czf "${OUTPUT_DIR}/${name}.tar.gz" apache)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar ${arguments}
  WORKING_DIRECTORY "${PACKAGE_ROOT}" COMMAND_ERROR_IS_FATAL ANY)
